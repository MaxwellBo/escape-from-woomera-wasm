{
  "name": "escape-woomera-wasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Run the original Escape From Woomera Half-Life mod in the browser: a Windows build of Xash3D under Wine.",
  "scripts": {
    "dev": "vite --port 47831 --host 127.0.0.1",
    "build": "tsc && vite build",
