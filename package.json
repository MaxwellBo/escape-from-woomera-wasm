    "test:efw": "python3 game-logic/test_scripts.py",
    "build:win32": "bash scripts/build-win32.sh",
    "pack:wine": "python3 scripts/pack-wine.py",
    "build:hlsdk": "bash scripts/build-hlsdk.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
