 using namespace vgui;
 
 App* App::_instance = nullptr;
+
+/* IP-relative App slot.
+ * client.dll and vgui.dll both prefer image base 0x10000000, so one of
+ * them is relocated. Boxedwine has returned a null App from the absolute
+ * load in getInstance after the constructor stored `this`. A displacement
+ * from the instruction pointer stays valid at whatever base the DLL got. */
+#if defined( _WIN32 ) && ( defined( __i386__ ) || defined( _M_IX86 ))
+extern "C" App *efw_app_slot = nullptr;
+__attribute__(( naked )) static App **instance_slot()
+{
+	asm(
+		"call 1f\n\t"
+		"1:\n\t"
+		"popl %eax\n\t"
+		"addl $(_efw_app_slot - 1b), %eax\n\t"
+		"ret\n\t"
+	);
+}
+static App *load_instance()
+{
+	return *instance_slot();
+}
+static void store_slot( App *app )
+{
+	*instance_slot() = app;
+}
+#else
+static App *load_instance()
+{
+	return nullptr;
+}
+static void store_slot( App * )
+{
+}
+#endif
