@@ -33,6 +33,12 @@ FontPlat_Win32::~FontPlat_Win32()
 
 FontPlat_Win32 *FontPlat_Win32::Create( const char *name, int tall, int wide, float rotation, int weight, bool italic, bool underline, bool strikeout, bool symbol )
 {
+	/* Wine GDI font calls fault Boxedwine while the HUD builds its default
+	   text scheme. The stub face draws boxes and keeps the client alive. */
+	(void)name; (void)tall; (void)wide; (void)rotation; (void)weight;
+	(void)italic; (void)underline; (void)strikeout; (void)symbol;
