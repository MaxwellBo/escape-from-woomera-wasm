 	if( !name )
 		return false;
 
+	/* Boxedwine's GDI faults on a zero-height font or a zero-size DIB. */
+	if( newTall <= 0 )
+		newTall = 17;
+	if( newWide < 0 )
+		newWide = 0;
+
 	tall = newTall;
 	wide = newWide;
 	rotation = newRotation;
