diff --git a/platform/win32/font.cpp b/platform/win32/font.cpp
index 44854ce..0c101b9 100644
--- a/platform/win32/font.cpp
+++ b/platform/win32/font.cpp
@@ -57,6 +57,12 @@ bool FontPlat_Win32::init( const char *newName, int newTall, int newWide, float
 	if( !name )
 		return false;
 
+	/* Boxedwine's GDI faults on a zero-height font or a zero-size DIB. */
+	if( newTall <= 0 )
+		newTall = 17;
+	if( newWide < 0 )
+		newWide = 0;
+
 	tall = newTall;
 	wide = newWide;
 	rotation = newRotation;
@@ -100,6 +106,12 @@ bool FontPlat_Win32::init( const char *newName, int newTall, int newWide, float
 	height = tm.tmHeight;
 	maxCharWidth = tm.tmMaxCharWidth;
 
+	if( height <= 0 || maxCharWidth <= 0 )
+	{
+		vgui_dprintf( "vgui: empty text metrics for \"%s\" (%d x %d)\n", name, maxCharWidth, height );
+		return false;
+	}
+
 	// scratch surface for the ExtTextOut fallback below. Top-down (negative height) so its rows match the RGBA buffer we copy into.
 	dibSize[0] = maxCharWidth;
