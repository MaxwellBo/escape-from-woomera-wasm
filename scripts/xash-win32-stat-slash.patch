@@ -240,6 +240,32 @@ void FS_CreatePath( char *path )
 	}
 }
 
+#if XASH_WIN32
+/*
+ * Boxedwine's msvcrt returns ENOENT for a directory path that ends in a
+ * slash. Search paths are stored that way, so the directory cache treated
+ * a real game folder as missing and never opened maps inside it.
+ */
+static const char *FS_TrimTrailingSlash( const char *path )
+{
+	static char trimmed[MAX_SYSPATH];
+	size_t len;
+
+	if( !path || !path[0] )
+		return path;
+
+	len = Q_strlen( path );
+	if( len > 1 && len < sizeof( trimmed ) && ( path[len - 1] == '/' || path[len - 1] == '\\' ))
+	{
+		memcpy( trimmed, path, len - 1 );
+		trimmed[len - 1] = '\0';
+		return trimmed;
+	}
+
+	return path;
+}
+#endif
