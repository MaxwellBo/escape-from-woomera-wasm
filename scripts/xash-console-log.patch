 void Sys_Print( const char *pMsg )
 {
+#if XASH_WIN32
+	/* The C runtime writes a console one byte at a time. Wine turns each
+	   byte into a cursor sequence, which stalls the emulator. WriteFile
+	   sends the whole line in one call, the same way cmd.exe echo does. */
+	if( pMsg && pMsg[0] )
+	{
+		HANDLE out = GetStdHandle( STD_OUTPUT_HANDLE );
+		DWORD wrote = 0;
+		if( out && out != INVALID_HANDLE_VALUE )
+			WriteFile( out, pMsg, (DWORD)Q_strlen( pMsg ), &wrote, NULL );
+	}
+#endif
 #if !XASH_DEDICATED
 	if( !Host_IsDedicated() )
 	{
