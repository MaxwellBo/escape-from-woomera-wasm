 void Win32_Init( qboolean con_showalways )
 {
+	/* The launcher is a GUI image, so the C runtime's stdout is not the
+	   console cmd.exe is already attached to. Reattach and point stdout at
+	   it. Boxedwine forwards that console into the page log. */
+	if( AttachConsole( ATTACH_PARENT_PROCESS ) || GetConsoleWindow( ))
+	{
+		/* Line buffered. Unbuffered stdout makes Wine emit a cursor
+		   sequence per byte, which floods the page log and stalls startup. */
+		if( freopen( "CONOUT$", "w", stdout ))
+			setvbuf( stdout, NULL, _IOLBF, 0 );
+		if( freopen( "CONOUT$", "w", stderr ))
+			setvbuf( stderr, NULL, _IOLBF, 0 );
+	}
+
 	HMODULE hModule = LoadLibraryW( L"kernel32.dll" );
